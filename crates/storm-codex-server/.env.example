# storm-codex-server — configuration (all variables from env, stateless server / V2-ready).
# Copy to .env for local dev (not committed). In box prod: values in the box's .env.

# ── Obligatoire ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://storm:storm@localhost:5433/storm_codex   # dev: docker-compose.dev.yml

# ── Network / front-end ──────────────────────────────────────────────────────
BIND_ADDR=127.0.0.1:8088          # container prod: 0.0.0.0:8088
WEB_DIR=                          # path of the built SPA (web/dist); empty = API only

# ── Storage (3 data tiers) ───────────────────────────────────────────────────
ARCHIVE_DIR=./.archive            # raw replays = source of truth (never purge)
RAW_CACHE_DIR=./.raw-cache        # LRU cache of dumps decoded on demand
RAW_CACHE_MAX_BYTES=5368709120    # 5 GiB

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=                      # empty/absent = open mode (local); set = Bearer auth on /api/admin/* + management

# ── Hero/talent reference data (read-only) ───────────────────────────────────
HOTSPATCHNOTES_URL=http://localhost:5001   # replicated into dim_* at startup; absent = skip

# ── Opt-in push (set at the milestone 5 switchover — see runbook) ────────────
REDIS_URL=                        # Jarvis Redis: emits hots.match.completed; absent = no emission
JARVIS_CHANNEL=jarvis:events
AZURE_PUSH_URL=                   # Twitch Azure EBS: outgoing post-game push; absent = no push
AZURE_PUSH_TOKEN=
