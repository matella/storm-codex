{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storm-codex-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web", "--", "--port", "5180", "--strictPort"],
      "port": 5180
    },
    {
      "name": "storm-codex-server",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:BIND_ADDR='127.0.0.1:8089'; $env:WEB_DIR='./web/dist'; $env:DATABASE_URL='postgres://storm:storm@localhost:5433/storm_codex'; $env:HOTSPATCHNOTES_URL='http://192.168.129.85:5001'; ./target/release/storm-codex-server.exe"],
      "port": 8089
    }
  ]
}
