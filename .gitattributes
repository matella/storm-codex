# sqlx migrations are checked by checksum over their exact bytes: a Windows checkout
# (autocrlf) in CRLF makes them "modified" for a database migrated in LF (VersionMismatch).
crates/storm-codex-server/migrations/*.sql text eol=lf

# GADS: managed files are checked by SHA-256 sum (gads/install.json); a Windows checkout
# (autocrlf) in CRLF would make them look modified (audit, upgrade and uninstall).
AGENTS.md text eol=lf
CLAUDE.md text eol=lf
gads/** text eol=lf
.claude/agents/** text eol=lf
.claude/settings.json text eol=lf

# shell scripts run in CI (Linux)
*.sh text eol=lf
