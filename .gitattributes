# Les migrations sqlx sont vérifiées par somme de contrôle sur leurs octets exacts : un checkout
# Windows (autocrlf) en CRLF les rend « modifiées » pour une base migrée en LF (VersionMismatch).
crates/storm-codex-server/migrations/*.sql text eol=lf

# GADS : les fichiers gérés sont vérifiés par somme SHA-256 (gads/install.json) ; un checkout
# Windows (autocrlf) en CRLF les ferait passer pour modifiés (audit, upgrade et uninstall).
AGENTS.md text eol=lf
CLAUDE.md text eol=lf
gads/** text eol=lf
.claude/agents/** text eol=lf
.claude/settings.json text eol=lf
