# storm-codex-server — config (copy to .env, not committed). Dev = Docker Postgres (5433).
DATABASE_URL=postgres://storm:storm@localhost:5433/storm_codex
BIND_ADDR=127.0.0.1:8088
# Raw replay archive (source of truth — 3 data tiers)
ARCHIVE_DIR=./.archive
# LRU cache of dumps decoded on demand (milestone 3 T7)
RAW_CACHE_DIR=./.raw-cache
RAW_CACHE_MAX_BYTES=5368709120
# Admin token (/api/admin endpoints). EMPTY or absent = open mode, no auth (local LAN/Tailscale
# self-hosting). Setting it re-enables Bearer auth (recommended if publicly exposed).
ADMIN_TOKEN=
# Hero/talent reference data — HotsPatchNotes API (maintainer setup). In a bundle, leave empty and
# use REFERENTIAL_URL (published snapshot) instead.
HOTSPATCHNOTES_URL=http://localhost:5001
# Jarvis (Redis) + Twitch Azure
REDIS_URL=redis://127.0.0.1:6380
JARVIS_CHANNEL=jarvis:events
# AZURE_PUSH_URL=
# AZURE_PUSH_TOKEN=
